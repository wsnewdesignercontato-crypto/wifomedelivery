{
  "name": "WiFome",
  "short_name": "WiFome",
  "description": "Peça comida e acompanhe suas entregas em tempo real no WiFome.",
  "start_url": "/auth?perfil=cliente",
  "scope": "/",
  "id": "/wifome-cliente",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B0B0F",
  "theme_color": "#FF6B00",
  "lang": "pt-BR",
  "categories": ["food", "shopping", "lifestyle"],
  "icons": [
    {
      "src": "/wifome-logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest-cliente.webmanifest"
    }
  ]
}
