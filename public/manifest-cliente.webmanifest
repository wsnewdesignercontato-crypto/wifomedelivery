{
  "name": "PedeTrem",
  "short_name": "PedeTrem",
  "description": "Peça comida e acompanhe suas entregas em tempo real no PedeTrem.",
  "start_url": "/cliente?app=cliente",
  "scope": "/cliente",
  "id": "/wifome-cliente",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B0B0F",
  "theme_color": "#E10B17",
  "lang": "pt-BR",
  "categories": [
    "food",
    "shopping",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "/icons/cliente-any-512-v2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/cliente-any-192-v2.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/cliente-maskable-512-v2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest-cliente.webmanifest",
      "id": "/wifome-cliente"
    }
  ]
}
