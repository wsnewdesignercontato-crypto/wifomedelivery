{
  "name": "PedeTrem Cliente",
  "short_name": "PT Cliente",
  "description": "Peça comida e acompanhe suas entregas em tempo real no PedeTrem.",
  "start_url": "/cliente?app=cliente",
  "scope": "/",
  "id": "/wifome-cliente",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B0B0F",
  "theme_color": "#E10B17",
  "lang": "pt-BR",
  "categories": ["food", "shopping", "lifestyle"],
  "icons": [
    {
      "src": "/pedetrem-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest-cliente.webmanifest",
      "id": "/wifome-cliente"
    },
    {
      "platform": "webapp",
      "url": "/manifest-estabelecimento.webmanifest",
      "id": "/wifome-estabelecimento"
    },
    {
      "platform": "webapp",
      "url": "/manifest-entregador.webmanifest",
      "id": "/wifome-entregador"
    }
  ]
}
