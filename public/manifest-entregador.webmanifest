{
  "name": "PedeTrem Entregador",
  "short_name": "PT Entrega",
  "description": "Receba corridas, faça entregas e acompanhe seus ganhos no PedeTrem.",
  "start_url": "/entregador/entrar?app=entregador",
  "scope": "/entregador",
  "id": "/wifome-entregador",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B0B0F",
  "theme_color": "#07883B",
  "lang": "pt-BR",
  "categories": [
    "business",
    "navigation",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icons/entregador-any-512-v2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/entregador-any-192-v2.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/entregador-maskable-512-v2.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest-entregador.webmanifest",
      "id": "/wifome-entregador"
    }
  ]
}
