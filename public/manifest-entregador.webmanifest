{
  "name": "WiMoto",
  "short_name": "WiMoto",
  "description": "Receba corridas, faça entregas e acompanhe seus ganhos no WiFome.",
  "start_url": "/auth?perfil=entregador",
  "scope": "/",
  "id": "/wifome-entregador",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B0B0F",
  "theme_color": "#3FA845",
  "lang": "pt-BR",
  "categories": ["business", "navigation", "productivity"],
  "icons": [
    {
      "src": "/wifome-logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest-entregador.webmanifest"
    }
  ]
}
