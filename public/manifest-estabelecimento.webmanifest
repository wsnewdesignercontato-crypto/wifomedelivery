{
  "name": "PedeTrem Loja",
  "short_name": "PedeTrem",
  "description": "Gerencie pedidos, cardápio e entregas do seu estabelecimento no PedeTrem.",
  "start_url": "/auth?perfil=estabelecimento",
  "scope": "/",
  "id": "/wifome-estabelecimento",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B0B0F",
  "theme_color": "#E10B17",
  "lang": "pt-BR",
  "categories": [
    "business",
    "food",
    "productivity"
  ],
  "icons": [
    {
      "src": "/pedetrem-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pedetrem-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest-estabelecimento.webmanifest"
    }
  ]
}
