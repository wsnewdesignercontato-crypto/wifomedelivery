# Public configuration (included in the browser build).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_APP_URL=http://localhost:3000

# Server configuration. Use private Vercel environment variables in production.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_MAPS_API_KEY=
APP_URL=http://localhost:3000

# AI Gateway uses deployment OIDC on Vercel; an API key is optional for local use.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=google/gemini-3-flash

# Web Push: preserve the existing VAPID key pair when moving the application.
PUSH_DISPATCH_SECRET=
VAPID_PRIVATE_JWK=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:contato@wifomedelivery.com
